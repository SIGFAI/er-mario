+/// The file libsm64 is loaded from, in the mod folder.
+pub const DLL: &str = "sm64.dll";
+
+/// Declares libsm64's functions: each becomes a `pub unsafe fn` of the same name and signature
+/// that calls the function of that name in sm64.dll (loaded on first use, see `load`).
+macro_rules! libsm64 {
+    ($( $(#[$m:meta])* fn $name:ident($($arg:ident: $ty:ty),* $(,)?) $(-> $ret:ty)?; )*) => {
+        struct Api {
+            $( $name: unsafe extern "C" fn($($ty),*) $(-> $ret)?, )*
+        }
+
+        impl Api {
+            unsafe fn resolve(lib: HMODULE) -> Result<Self, String> {
+                Ok(Self {
+                    $( $name: {
+                        let f = unsafe { GetProcAddress(lib, PCSTR(concat!(stringify!($name), "\0").as_ptr())) }
+                            .ok_or_else(|| format!("{DLL} has no {}: it is not er-mario's libsm64", stringify!($name)))?;
+                        unsafe { std::mem::transmute::<unsafe extern "system" fn() -> isize, unsafe extern "C" fn($($ty),*) $(-> $ret)?>(f) }
+                    }, )*
+                })
+            }
+        }
+
+        $(
+            $(#[$m])*
+            pub unsafe fn $name($($arg: $ty),*) $(-> $ret)? {
+                unsafe { (api().$name)($($arg),*) }
+            }
+        )*
+    };
+}
+
+static API: OnceLock<Result<Api, String>> = OnceLock::new();
+
+fn loaded() -> &'static Result<Api, String> {
+    API.get_or_init(|| {
+        let path = crate::paths::file(DLL);
+        let wide: Vec<u16> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+        // (an absolute path: Windows loads exactly that file, never one found on the search path)
+        let lib = unsafe { LoadLibraryW(PCWSTR(wide.as_ptr())) }.map_err(|e| format!("could not load {}: {e}", path.display()))?;
+        unsafe { Api::resolve(lib) }
+    })
+}
+
+/// Loads sm64.dll from the mod folder (once) and finds all of libsm64's functions in it.
+pub fn load() -> Result<(), String> {
+    loaded().as_ref().map(|_| ()).map_err(Clone::clone)
+}
+
+fn api() -> &'static Api {
+    match loaded() {
+        Ok(api) => api,
+        Err(e) => panic!("libsm64: {e}"),
+    }
+}
